<footer class="border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)] py-20 lg:py-28" role="contentinfo">
  <div class="container">
    <div class="grid lg:grid-cols-5 gap-12 lg:gap-16 mb-16 lg:mb-16">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-8">
          <svg class="w-9 h-9 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="text-3xl font-bold text-[var(--color-text-primary)]">kube-triage</span>
        </div>
        <p class="text-[var(--color-text-secondary)] max-w-xs mb-8 leading-relaxed">
          AI-Powered Kubernetes Diagnostic Engine. From CrashLoopBackOff to root cause in seconds.
        </p>
        <div class="flex items-center gap-5">
          <a href="https://github.com/Jani-shiv/kube-triage" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors" aria-label="GitHub">
