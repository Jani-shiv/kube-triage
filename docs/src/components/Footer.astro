          <li><a href="/reference/rules" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Rules Reference</a></li>
          <li><a href="/ai/overview" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">AI Providers</a></li>
          <li><a href="/reference/cli" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">CLI Reference</a></li>
        </ul>
      </nav>

      <nav class="space-y-5 mt-10">
        <h3 class="font-semibold text-[var(--color-text-primary)] mb-5">Resources</h3>
        <ul class="space-y-3" role="list">
          <li><a href="https://github.com/Jani-shiv/kube-triage" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">GitHub Repository</a></li>
          <li><a href="https://github.com/Jani-shiv/kube-triage/issues" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Issues & Bug Reports</a></li>
          <li><a href="https://github.com/Jani-shiv/kube-triage/discussions" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Discussions</a></li>
          <li><a href="https://github.com/Jani-shiv/kube-triage/releases" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Releases</a></li>
        </ul>
      </nav>

      <nav class="space-y-5 mt-10">
        <h3 class="font-semibold text-[var(--color-text-primary)] mb-5">Community</h3>
        <ul class="space-y-3" role="list">
          <li><a href="/development/contributing" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Contributing</a></li>
          <li><a href="/development/building" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Building from Source</a></li>
          <li><a href="/development/testing" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Running Tests</a></li>
        </ul>
      </nav>

      <div class="mt-10">
        <h3 class="font-semibold text-[var(--color-text-primary)] mb-5">Legal</h3>
        <ul class="space-y-3" role="list">
          <li><a href="https://github.com/Jani-shiv/kube-triage/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">MIT License</a></li>
          <li><a href="/privacy" class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">Privacy Policy</a></li>
