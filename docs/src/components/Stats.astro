      <div class="text-center group">
        <dt class="text-5xl lg:text-6xl font-bold gradient-text group-hover:scale-110 transition-transform duration-300">4</dt>
        <dd class="mt-4 text-[var(--color-text-secondary)] font-medium">AI Providers</dd>
