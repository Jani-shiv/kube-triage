<section class="py-20 lg:py-32 bg-[var(--color-bg-secondary)] border-y border-[var(--color-border)]" aria-labelledby="stats-heading">
  <div class="container">
    <h2 id="stats-heading" class="sr-only">Project Statistics</h2>
    <dl class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
