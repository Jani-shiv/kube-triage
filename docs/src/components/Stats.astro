      <div class="text-center group">
        <dt class="text-5xl lg:text-6xl font-bold gradient-text group-hover:scale-110 transition-transform duration-300">6</dt>
        <dd class="mt-4 text-[var(--color-text-secondary)] font-medium">Collectors</dd>
      </div>
      <div class="text-center group">
        <dt class="text-5xl lg:text-6xl font-bold gradient-text group-hover:scale-110 transition-transform duration-300">100%</dt>
