---
---

<section class="relative overflow-hidden pt-20 pb-32 lg:pt-32 lg:pb-40">
  <div class="absolute inset-0 bg-gradient-to-br from-brand-50/50 via-transparent to-kube-50/50 dark:from-brand-900/20 dark:via-transparent dark:to-kube-900/20" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-5" aria-hidden="true"></div>
  
  <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-100 text-brand-700 dark:bg-brand-900/30 dark:text-brand-300 text-sm font-medium mb-8 animate-in">
        <span class="relative flex h-2 w-2">
          <span class="animate-pulse-soft absolute inline-flex h-full w-full rounded-full bg-brand-500 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-500"></span>
        </span>
        <span>v1.0.0 released</span>
      </div>
      
      <h1 class="text-5xl lg:text-7xl font-bold tracking-tight text-[var(--color-text-primary)] mb-8 animate-in">
        <span class="block">kube-triage</span>
        <span class="block gradient-text">AI Kubernetes Diagnostic Engine</span>
      </h1>
      
      <p class="text-xl lg:text-2xl text-[var(--color-text-secondary)] max-w-3xl mx-auto mb-12 animate-in">
        From <code class="bg-brand-100 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 px-2 py-1 rounded font-mono text-lg">CrashLoopBackOff</code> to root cause in seconds. 
        Analyze failing Kubernetes resources, pinpoint root causes instantly, and get precise, production-safe remediation commands.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 animate-in">
        <a href="/getting-started/quick-start" class="btn-primary text-lg px-8 py-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Quick Start
        </a>
        <a href="https://github.com/Jani-shiv/kube-triage" target="_blank" rel="noopener noreferrer" class="btn-secondary text-lg px-8 py-3">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
          View on GitHub
        </a>
      </div>
      
      <div class="flex flex-wrap items-center justify-center gap-8 text-sm text-[var(--color-text-muted)] animate-in">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Production Ready
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l2 2a1 1 0 001.414-1.414l-2-2a1 1 0 001.414 0z" clip-rule="evenodd" />
          </svg>
          MIT Licensed
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 text-purple-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414-1.414l2 2a1 1 0 001.414 0l2 2a1 1 0 001.414-1.414l-2-2a1 1 0 001.414 0z" clip-rule="evenodd" />
          </svg>
          AI-Powered
        </span>
      </div>
    </div>
    
    <div class="mt-20 relative">
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-transparent to-transparent z-10 h-32 bottom-0 pointer-events-none" aria-hidden="true"></div>
      <div class="rounded-2xl border border-[var(--color-border)] overflow-hidden bg-[var(--color-bg-secondary)] shadow-2xl">
        <div class="flex items-center gap-2 px-4 py-3 bg-[var(--color-bg-tertiary)] border-b border-[var(--color-border)]">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
          <div class="flex-1 text-center text-xs text-[var(--color-text-muted)] font-mono">kube-triage analyze pod failing-app -n production</div>
        </div>
        <div class="p-6 font-mono text-sm overflow-x-auto">
          <pre class="text-[var(--color-text-primary)]"><code>kube-triage output preview available in Quick Start guide</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>